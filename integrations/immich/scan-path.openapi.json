{
  "openapi": "3.0.3",
  "info": {
    "title": "Immich scoped library scan extension",
    "version": "3.2.2-gather.1"
  },
  "paths": {
    "/libraries/{id}/scan/path": {
      "post": {
        "description": "Recursively import and refresh assets only within an existing directory of this library. Other directories and library import paths are unchanged.",
        "operationId": "scanLibraryPath",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          },
          {
            "api_key": []
          }
        ],
        "summary": "Scan a library directory",
        "tags": [
          "Libraries"
        ],
        "x-immich-admin-only": true,
        "x-immich-history": [
          {
            "version": "v3",
            "state": "Added"
          }
        ],
        "x-immich-permission": "library.update",
        "x-immich-state": "Stable",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanLibraryPathDto"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScanLibraryPathDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Absolute directory within this library to scan recursively"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "Bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "in": "header"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "immich_access_token"
      },
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "servers": [
    {
      "url": "/api"
    }
  ]
}
