+  private async validateScanPath(id: string, directory: string): Promise<string> {
+    const library = await this.findOrFail(id);
+    if (!isAbsolute(directory) || directory.includes('\\') || directory.includes('\0') || directory.split('/').includes('..')) {
+      throw new BadRequestException('Scan path must be an absolute directory without traversal segments');
+    }
+    const normalized = path.normalize(directory).replace(/[/]+$/, '') || '/';
+    const contains = (root: string, candidate: string) => {
+      const relative = path.relative(root, candidate);
+      return relative === '' || (!relative.startsWith('..' + path.sep) && relative !== '..' && !isAbsolute(relative));
+    };
+    if (!library.importPaths.some((root) => contains(path.resolve(root), normalized))) {
+      throw new BadRequestException('Scan path must be within a configured library import path');
+    }
+    const validation = await this.validateImportPath(normalized);
+    if (!validation.isValid) throw new BadRequestException(`Invalid scan path: ${validation.message}`);
+    const resolved = await this.storageRepository.realpath(normalized);
+    if (resolved !== normalized) throw new BadRequestException('Symbolic links are not allowed in a scan path');
+    const roots = await Promise.all(library.importPaths.map(async (root) => {
+      try { return await this.storageRepository.realpath(root); } catch { return undefined; }
+    }));
+    if (!roots.some((root) => root && contains(root, resolved))) {
+      throw new BadRequestException('Scan path resolves outside the library import paths');
+    }
+    return normalized;
+  }
+
+  async queueScanPath(id: string, directory: string) {
+    const scanPath = await this.validateScanPath(id, directory);
+    this.logger.log(`Starting scoped scan of ${scanPath} in library ${id}`);
+    await this.jobRepository.queue({ name: JobName.LibrarySyncFilesQueueAll, data: { id, path: scanPath } });
+    await this.jobRepository.queue({ name: JobName.LibrarySyncAssetsQueueAll, data: { id, path: scanPath } });
+  }
+
