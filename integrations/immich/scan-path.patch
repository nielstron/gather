@@ -118,7 +118,14 @@ export class LibraryRepository {
     };
   }
 
-  streamAssetIds(libraryId: string) {
-    return this.db.selectFrom('asset').select(['id']).where('libraryId', '=', libraryId).stream();
+  streamAssetIds(libraryId: string, directory?: string) {
+    let query = this.db.selectFrom('asset').select(['id']).where('libraryId', '=', libraryId);
+    if (directory) {
+      // A directory separator prevents sibling-prefix matches; escape LIKE metacharacters.
+      const prefix = directory.replace(/[/]+$/, '') + '/';
+      const pattern = prefix.replaceAll('!', '!!').replaceAll('%', '!%').replaceAll('_', '!_') + '%';
+      query = query.where(sql<boolean>`"originalPath" LIKE ${pattern} ESCAPE '!'`);
+    }
+    return query.stream();
   }
 }
