{
  "name": "gather-photos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --host 127.0.0.1",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "user": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/user.ts",
    "test:e2e": "npm run build && playwright test",
    "share": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig scripts/tsconfig.json scripts/share.ts"
  },
  "dependencies": {
    "@immich/ui": "0.91.0",
    "@mdi/js": "^7.4.47",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.4.1",
    "justified-layout": "4.1.0",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/justified-layout": "^4.1.0",
    "@types/node": "^22.0.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
