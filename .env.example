# Local development. Use HTTPS and COOKIE_SECURE=true behind your reverse proxy.
ORIGIN=http://localhost:5173
# Optional URL prefix. Rebuild after changing (e.g. /gather). ORIGIN has no path.
GATHER_BASE_PATH=
HOST=127.0.0.1
PORT=5173
COOKIE_SECURE=false
COLLECTION_NAME="Our shared moments"
PHOTO_ROOT=./var/photos
# Only directories inside this root are available in the administrator folder picker.
PHOTO_ALLOWED_ROOT=./var/photos
# Optional mapping of that root inside Immich; selected subfolders map automatically.
IMMICH_ALLOWED_ROOT=/external/gather
DATA_ROOT=./var/data
MAX_UPLOAD_MB=50
# The Node adapter's request limit must be >= MAX_UPLOAD_MB.
BODY_SIZE_LIMIT=52M
SESSION_DAYS=30

# Existing Immich server and an external library owned by the API key's user.
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=
IMMICH_LIBRARY_ID=
# Absolute path to PHOTO_ROOT as seen INSIDE the Immich server container.
IMMICH_PHOTO_ROOT=/external/gather
# Optional separate ADMIN key with library.update. If empty, uses IMMICH_API_KEY.
IMMICH_SCAN_API_KEY=

# Docker Compose host paths (ignored by the app itself).
GATHER_PHOTOS=./var/photos
GATHER_DATA=./var/data

# Host root containing the folders offered in the admin folder picker.
GATHER_FOLDER_ROOT=./var/photos
